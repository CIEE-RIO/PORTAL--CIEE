rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null && request.auth.token.email != null;
    }

    function perfilUsuario() {
      return get(/databases/$(database)/documents/usuarios_login/$(request.auth.token.email));
    }

    function usuarioAtivo() {
      return autenticado();
    }

    function admin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios_login/$(request.auth.token.email))
        && perfilUsuario().data.perfil == "admin";
    }

    function podeEscrever() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios_login/$(request.auth.token.email))
        && (perfilUsuario().data.perfil == "admin"
          || perfilUsuario().data.podeEscrever == true);
    }

    match /usuarios_login/{document=**} {
      allow read: if usuarioAtivo();
      allow write: if admin();
    }

    match /acessos_portal/{document} {
      allow read: if admin();
      allow create: if autenticado()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'email',
          'nome',
          'perfil',
          'modulos',
          'tipo',
          'modulo',
          'pagina',
          'userAgent',
          'criadoEm',
          'criadoEmCliente'
        ]);
      allow update, delete: if admin();
    }

    match /{collection}/{document=**} {
      allow read: if usuarioAtivo() && collection != "acessos_portal";
      allow write: if podeEscrever() && collection != "acessos_portal";
    }
  }
}
